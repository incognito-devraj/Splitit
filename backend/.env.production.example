# ─── Copy this to your deployment platform's environment variables ────────────
# DO NOT commit real values. This file is a template only.

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas — use your Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/splitit?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be at least 64 characters in production
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_1
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth — from Google Cloud Console
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-YOUR_SECRET

# CORS — your deployed frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
# Optional: deployed backend origin, used for generated API docs outside production.
# API_PUBLIC_URL=https://your-backend.onrender.com
# Optional: comma-separated extra origins
# CORS_ORIGINS=https://www.your-app.com,https://staging.your-app.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
