# ─── Copy these to Render → Environment Variables ────────────────────────────
# DO NOT commit real values. This file is a template only.

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/splitit?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_1
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-YOUR_SECRET

# CORS — primary frontend URL (no trailing slash)
FRONTEND_URL=https://mysplitit.vercel.app

# Optional: comma-separated extra allowed origins
# CORS_ORIGINS=https://www.mysplitit.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
